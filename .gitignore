__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# Archivos fuente crudos (pesados, re-descargables desde la fuente original)
raw/*.csv
raw/*.xlsx
!raw/.gitkeep

# Salidas versionadas localmente pero no en el repo (pueden crecer mucho)
output/*.csv
!output/.gitkeep

# Credenciales del proyecto (service account de Firebase, etc.) — nunca al repo
credentials/*
!credentials/.gitkeep
*firebase_service_account*.json
.env
